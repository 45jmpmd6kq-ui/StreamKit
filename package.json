{
  "name": "streamkit",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "description": "Socle commun des outils de stream : une application, des modules activables, mise a jour automatique.",
  "scripts": {
    "start": "electron .",
    "dev": "node src/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "icone": "node scripts/faire-icone.mjs",
    "dist": "electron-builder --win",
    "publier": "electron-builder --win --publish always"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.streamkit.app",
    "productName": "StreamKit",
    "copyright": "StreamKit",
    "directories": {
      "output": "livraison"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icone.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamKit",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "45jmpmd6kq-ui",
        "repo": "StreamKit",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "allowScripts": {}
}
