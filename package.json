{
  "name": "streamkit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "description": "Socle commun des outils de stream : une application, des modules activables, mise a jour automatique.",
  "scripts": {
    "start": "electron .",
    "dev": "node src/index.js",
    "icone": "node scripts/faire-icone.mjs",
    "dist": "electron-builder --win",
    "publier": "electron-builder --win --publish always"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@twurple/api": "^7.2.0",
    "@twurple/auth": "^7.2.0",
    "@twurple/chat": "^7.2.0",
    "@twurple/eventsub-ws": "^7.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.streamkit.app",
    "productName": "StreamKit",
    "copyright": "StreamKit",
    "directories": {
      "output": "livraison"
    },
    "asar": false,
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icone.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamKit",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "45jmpmd6kq-ui",
        "repo": "StreamKit"
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
